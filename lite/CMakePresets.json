{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "arm-gcc",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/ArmGNUToolchain.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "DAISY_STORAGE": "qspi"
      }
    }
  ]
}
